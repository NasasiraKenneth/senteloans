# =============================================================================
# SENTELOANS ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (plain Postgres - no Supabase required)
# -----------------------------------------------------------------------------
# Connection string for your PostgreSQL database
# Example: postgresql://user:password@localhost:5432/senteloans

DATABASE_URL=postgresql://kenn:kenn@localhost:5432/senteloans

# -----------------------------------------------------------------------------
# NextAuth (replaces Supabase Auth)
# -----------------------------------------------------------------------------
# Secret for signing JWT session cookies. Generate: openssl rand -base64 32

NEXTAUTH_SECRET=asdfasdfasdfasgdtgdsfsdf
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email Service Configuration (Mailgun)
# -----------------------------------------------------------------------------
# Get these from Mailgun dashboard: https://app.mailgun.com
# Used for contact forms and system notifications

MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org

# Contact form recipient email (where contact form submissions are sent)
CONTACT_EMAIL=info@senteloans.com

# -----------------------------------------------------------------------------
# Vercel Blob Storage Configuration
# -----------------------------------------------------------------------------
# Used for storing KYC documents, profile photos, and other user uploads
# Get this from Vercel: https://vercel.com/docs/storage/vercel-blob
# Dashboard > Storage > Create Blob Store > Copy Read/Write Token

BLOB_READ_WRITE_TOKEN="vercel_blob_rw_ExM7whVJbwL0ZRUY_8aRtlNmHwbnxCxghMMPH90aNs44UHJ"

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Application URL (used for callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

NEXT_TIMEZONE=Africa/Nairobi

NEXT_PUBLIC_SOCKET_URL=http://localhost:3010

# -----------------------------------------------------------------------------
# Optional: SMS Configuration (Future Implementation)
# -----------------------------------------------------------------------------
# Africa's Talking or other SMS provider
# SMS_API_KEY=your-sms-api-key
# SMS_USERNAME=your-sms-username

# -----------------------------------------------------------------------------
# Optional: Mobile Money Integration (Future Implementation)
# -----------------------------------------------------------------------------
# MTN Mobile Money
# MTN_MOMO_API_KEY=your-mtn-momo-api-key
# MTN_MOMO_USER_ID=your-mtn-user-id

# Airtel Money
# AIRTEL_MONEY_API_KEY=your-airtel-api-key
# AIRTEL_MONEY_CLIENT_ID=your-airtel-client-id

# -----------------------------------------------------------------------------
# Legacy / Optional: Supabase (only if you revert to Supabase)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (for error monitoring)
# SENTRY_DSN=your-sentry-dsn
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable/disable features during development
# NEXT_PUBLIC_ENABLE_MOBILE_MONEY=false
# NEXT_PUBLIC_ENABLE_SMS_NOTIFICATIONS=false
# NEXT_PUBLIC_ENABLE_USSD=false


